[Unit]
Description=Prepare legacy NVIDIA devices for Jellyfin
After=systemd-modules-load.service
Before=docker.service
ConditionPathExists=/usr/bin/nvidia-modprobe

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=30
ExecStart=/usr/bin/nvidia-modprobe -c 0
ExecStart=/usr/bin/nvidia-modprobe -u -c 0
ExecStart=/usr/bin/test -c /dev/nvidia0
ExecStart=/usr/bin/test -c /dev/nvidiactl
ExecStart=/usr/bin/test -c /dev/nvidia-uvm
ExecStart=/usr/bin/test -c /dev/nvidia-uvm-tools

[Install]
WantedBy=multi-user.target
